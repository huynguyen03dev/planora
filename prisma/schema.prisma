// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum ActivityAction {
  CREATED
  UPDATED
  MOVED
  ARCHIVED
  RESTORED
  DELETED
  COMMENTED
}

enum ActivityEntityType {
  BOARD
  LIST
  CARD
  COMMENT
  MEMBER
  LABEL
  CHECKLIST
  ATTACHMENT
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  DUE_DATE
  COMMENT
  INVITE
}

enum CardHistoryEventType {
  CARD_CREATED
  CARD_MOVED
  CARD_COMPLETED
  CARD_REOPENED
  ESTIMATE_SET
  ESTIMATE_CHANGED
  DUE_DATE_SET
  DUE_DATE_CHANGED
  DUE_DATE_CLEARED
  CARD_MEMBER_ASSIGNED
  CARD_MEMBER_UNASSIGNED
  CARD_ARCHIVED
  CARD_RESTORED
  CARD_DELETED
  BASELINE_CAPTURED
}

// ─── Better Auth–managed tables ────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // BA relations
  sessions        Session[]
  accounts        Account[]
  workspacemembers WorkspaceMember[]
  invitations     Invitation[]

  // App relations
  boards        Board[]        @relation("BoardCreator")
  boardStars    BoardStar[]    @relation("UserBoardStars")
  cards         Card[]         @relation("CardCreator")
  cardMembers   CardMember[]   @relation("CardMembers")
  comments      Comment[]      @relation("UserComments")
  attachments   Attachment[]   @relation("UserAttachments")
  activities    Activity[]     @relation("UserActivities")
  notifications Notification[] @relation("UserNotifications")
  createdRules  Rule[]         @relation("RuleCreator")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id                        String    @id
  name                      String
  slug                      String
  logo                      String?
  timezone                  String    @default("UTC")
  requireEstimateBeforeDone Boolean   @default(false)
  analyticsLaunchAt         DateTime?
  createdAt                 DateTime
  metadata                  String?

  // BA relations
  workspacemembers WorkspaceMember[]
  invitations     Invitation[]

  // App relations
  boards               Board[]
  activities           Activity[]
  cardHistoryEvents    CardHistoryEvent[]
  rules                Rule[]
  ruleExecutionLogs    RuleExecutionLog[]

  @@unique([slug])
  @@map("workspace")
}

model WorkspaceMember {
  id             String    @id
  organizationId String
  workspace      Workspace @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String    @default("viewer")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("workspaceMember")
}

model Invitation {
  id             String    @id
  organizationId String
  workspace      Workspace @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  status         String    @default("pending")
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  inviterId      String
  user           User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ─── App-managed tables ────────────────────────────────────────────

model Board {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title           String
  backgroundColor String?
  createdById     String
  createdBy       User      @relation("BoardCreator", fields: [createdById], references: [id])
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lists      List[]
  stars      BoardStar[]
  labels     Label[]
  activities Activity[] @relation("BoardActivity")
  rules      Rule[]

  @@index([workspaceId])
  @@map("board")
}

model BoardStar {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserBoardStars", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  // getStarredBoardIds filters by userId alone; the [boardId, userId] composite
  // above can't serve it (leading column is boardId), so index userId directly.
  @@index([userId])
  @@map("boardStar")
}

model List {
  id         String    @id @default(uuid())
  boardId    String
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title      String
  position   Float
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  cards Card[]

  @@index([boardId, archivedAt])
  // Partial UNIQUE index `list_boardId_position_live_key` on (boardId, position)
  // WHERE archivedAt IS NULL enforces live-list position uniqueness (US-074, decision 0026).
  // It cannot be expressed as `@@unique` (Prisma has no WHERE predicate), so it lives in
  // migration SQL only and is intentionally invisible to `prisma migrate` — expect drift.
  @@map("list")
}

model Card {
  id            String    @id @default(uuid())
  listId        String
  list          List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  title         String
  description   String?   @db.Text
  position      Float
  priority      Priority?
  dueDate       DateTime?
  estimateHours Int?
  completedAt   DateTime?
  deletedAt     DateTime?
  coverImage    String?
  archivedAt    DateTime?
  createdById   String
  createdBy     User      @relation("CardCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members          CardMember[]
  labels           CardLabel[]
  checklists       Checklist[]
  comments         Comment[]
  attachments      Attachment[]
  activities       Activity[]        @relation("CardActivity")
  cardReminders    CardReminder[]

  @@index([listId, position])
  @@index([listId, archivedAt])
  @@index([dueDate, completedAt])
  // Partial UNIQUE index `card_listId_position_live_key` on (listId, position)
  // WHERE archivedAt IS NULL AND deletedAt IS NULL enforces live-card position
  // uniqueness (US-056, decision 0015). It cannot be expressed as `@@unique`
  // (Prisma has no WHERE predicate), so it lives in the
  // 20260701134906_card_position_integrity migration only and is intentionally
  // invisible to `prisma migrate` — expect a drift report; never drop it.
  @@map("card")
}

model CardMember {
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("CardMembers", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([cardId, userId])
  @@map("cardMember")
}

model Label {
  id        String   @id @default(uuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  color     String
  createdAt DateTime @default(now())

  cards CardLabel[]

  @@index([boardId])
  @@map("label")
}

model CardLabel {
  cardId  String
  card    Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@map("cardLabel")
}

model Checklist {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title     String
  position  Float
  createdAt DateTime @default(now())

  items ChecklistItem[]

  @@index([cardId])
  @@map("checklist")
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  position    Float
  createdAt   DateTime  @default(now())

  @@index([checklistId])
  @@map("checklistItem")
}

model Comment {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserComments", fields: [userId], references: [id])
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@map("comment")
}

model Attachment {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserAttachments", fields: [userId], references: [id])
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())

  // Cloudinary provider metadata (for future cleanup support)
  cloudinaryPublicId   String?
  cloudinaryResourceType String?

  @@index([cardId])
  @@map("attachment")
}

model Activity {
  id          String             @id @default(uuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boardId     String?
  board       Board?             @relation("BoardActivity", fields: [boardId], references: [id], onDelete: SetNull)
  cardId      String?
  card        Card?              @relation("CardActivity", fields: [cardId], references: [id], onDelete: SetNull)
  userId      String
  user        User               @relation("UserActivities", fields: [userId], references: [id])
  action      ActivityAction
  entityType  ActivityEntityType
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([boardId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("activity")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, isRead, createdAt])
  @@map("notification")
}

// ─── Scheduler bookkeeping (due-date reminders) ───────────────────

model CardReminder {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  milestone String   // "DUE_SOON" | "OVERDUE"
  sentAt    DateTime @default(now())

  @@unique([cardId, userId, milestone])
  @@index([cardId])
  @@map("cardReminder")
}

// ─── Automation rules engine ─────────────────────────────────────

model Rule {
  id            String   @id @default(uuid())
  workspaceId   String
  boardId       String?
  name          String
  description   String?
  enabled       Boolean  @default(true)
  triggerType   String
  triggerConfig Json
  actions       Json     // ordered array: [{ type, ...params }]; targets fixed IDs or dynamic tokens
  position      Float
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  board     Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  creator   User      @relation("RuleCreator", fields: [createdBy], references: [id])

  executionLogs RuleExecutionLog[]

  @@index([workspaceId, triggerType])
  @@index([workspaceId, enabled])
  @@map("rule")
}

model RuleExecutionLog {
  id          String   @id @default(uuid())
  // Denormalized workspace + rule name so the audit row survives rule deletion
  // (the CardHistoryEvent survival pattern). ruleId goes null on delete but the
  // workspace scope and the human-readable name remain for the log panel.
  workspaceId String
  ruleId      String?
  ruleName    String
  chainId     String?
  chainDepth  Int      @default(0)
  cardId      String?
  actionType  String
  triggerType String
  status      String
  error       String?
  dedupKey    String?
  metadata    Json?
  executedAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      Rule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([ruleId, dedupKey])
  @@index([workspaceId, executedAt])
  @@index([ruleId, executedAt])
  @@index([cardId])
  @@index([chainId])
  @@map("ruleExecutionLog")
}

// ─── Analytics History (append-only, survives card/list deletion) ───

model CardHistoryEvent {
  id           String               @id @default(uuid())
  sequence     BigInt               @default(autoincrement())
  workspaceId  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boardId      String
  cardId       String
  actorId      String?
  eventType    CardHistoryEventType
  occurredAt   DateTime             @default(now())
  metadata     Json?

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, boardId, occurredAt])
  @@index([cardId, sequence])
  @@index([workspaceId, eventType, occurredAt])
  @@map("cardHistoryEvent")
}
