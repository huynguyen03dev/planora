# VCS
.git
.gitignore

# Dependencies / build output (re-created inside the image)
node_modules
.next
out
build
coverage

# Generated Prisma client (re-generated by the build stage; never taken from
# the checkout so the image is deterministic on a fresh clone)
app/generated

# Secrets — never shipped into the image; Railway service variables supply
# them at runtime
.env
.env.*

# Local databases / harness artifacts
harness.db
harness.db-shm
harness.db-wal
harness.db.bak*
*.bak*
*.db
*.db-shm
*.db-wal
tmp
test-results
playwright-report
blob-report
playwright/.cache

# Demo fixture manifest (local database ids)
.demo

# Non-runtime source excluded from the image itself: docs and tests.
# NOTE: e2e/ is deliberately NOT excluded — `next build` type-checks the whole
# tsconfig tree and scripts/perf-measure.ts imports ../e2e/helpers. e2e stays
# in the build context for type-checking but is never copied into the runtime
# stage (the Dockerfile uses explicit path copies).
docs
tests

# Local-only tooling / caches
.pi
.harness-backup
.qa-shots
.ui-review
.mcp.json
.claude
