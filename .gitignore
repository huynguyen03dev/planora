# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# QA artifacts (manual browser QA + Playwright screenshots)
/.qa-shots/
/e2e/.qa-artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
.gitnexus

# bv (beads viewer) local config and caches
.bv/
.omx/

# local MCP server config (per-developer tooling, e.g. chrome-devtools)
.mcp.json

# Harness durable layer
harness.db
harness.db-wal
harness.db-shm
harness.db.bak*
scripts/bin/harness-cli
scripts/bin/harness-cli.exe

# Local scratch (agent/dev tooling — not deploy artifacts)
/tmp/

# Local agent/tool configs (per-developer, not shared)
.claude/

# Harness local artifacts (per-developer, not shared)
.harness-backup/
.pi/

# Beads issue tracker (no longer used)
.beads/

# Superpowers brainstorm artifacts (no longer used)
.superpowers/

# Playwright (E2E)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local UI-review screenshots (scratch, not tracked)
.ui-review/

# Generated demo-fixture manifest (current local database ids)
/.demo/
