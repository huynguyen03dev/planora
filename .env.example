# Planora environment — copy to .env and fill in. Values here are placeholders.

# --- Database (local dev via docker-compose: postgres:16-alpine, port 5432) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/planora?schema=public"

# --- Better Auth ---
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated; defaults to BETTER_AUTH_URL if unset.
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# --- Transactional email ---
# Production: set RESEND_API_KEY (real delivery). Email verification is enforced
# in every environment (decision 0023), so a working transport is required.
# RESEND_API_KEY="re_..."
EMAIL_FROM="Planora <noreply@localhost>"

# Dev/test mail sink (Mailpit, docker-compose). In NON-production, setting
# SMTP_HOST routes all mail to Mailpit so the real verification/reset link is
# retrievable at http://localhost:8025 (UI + REST API). Prod ignores SMTP_HOST.
# See lib/email.ts and decision 0025.
SMTP_HOST="localhost"
SMTP_PORT="1025"
# SMTP_USER=            # optional; Mailpit accepts any/no auth
# SMTP_PASS=

# --- Cron ---
CRON_SECRET="generate-with: openssl rand -base64 32"

# --- Cloudinary (attachments/covers) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
